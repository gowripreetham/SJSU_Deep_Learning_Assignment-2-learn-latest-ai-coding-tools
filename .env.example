# ===========================================
# LifeTrack - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# For Firebase Hosting deployment, set these in Firebase Console > Project Settings.

# --- Backend (Node.js / Express) ---
PORT=5000

# Firebase Admin SDK (for server-side Firestore access)
# Option 1: Path to service account JSON file (recommended for local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Or paste the full JSON as a single line (e.g. for Cloud Run / Railway)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- Frontend (React / Vite) ---
# Create client/.env with VITE_ prefix for React. These are public (client-safe).
# Get these from Firebase Console > Project Settings > General > Your apps.

# VITE_FIREBASE_API_KEY=your-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
# VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# --- API base URL (used by frontend to call backend) ---
# Local: http://localhost:5000
# Production: your deployed API URL
# VITE_API_BASE_URL=http://localhost:5000
