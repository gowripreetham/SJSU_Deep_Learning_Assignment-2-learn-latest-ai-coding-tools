# Optional: API base URL (no trailing slash)
# For local dev, Vite proxies /api to localhost:5000, so this is only needed
# when the frontend is served from a different origin than the API.
# VITE_API_BASE_URL=http://localhost:5000

# Firebase client config is not required for this app – all data goes through
# the Express API which uses Firebase Admin SDK with a service account.
